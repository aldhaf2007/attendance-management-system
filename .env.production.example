# ==============================================================================
# ARIGNAR ANNA COLLEGE Attendance System - Production Environment Configuration
# ==============================================================================

# Application Environment Mode ('production', 'development', or 'test')
ENVIRONMENT=production

# Application Version & Project Name
PROJECT_NAME="ARIGNAR ANNA COLLEGE - Attendance Tracker API"
VERSION="1.0.0"

# Application Port (Standard: 8000. Coolify automatically routes its proxy to this port)
PORT=8000

# Production JWT Secret Key: MUST be at least 32 random characters!
# Generate using: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_character_key_in_production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
KIOSK_PIN_TOKEN_EXPIRE_MINUTES=15

# Allowed CORS Origins (Comma-separated list of your production domains)
# Example: https://attendance.yourcollege.edu,https://your-coolify-domain.com
ALLOWED_ORIGINS=https://attendance.yourcollege.edu

# Database Connection String
# For MySQL: mysql+aiomysql://<user>:<password>@<host>:<port>/<dbname>
# For PostgreSQL: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# If using Coolify's built-in MySQL/Postgres service, paste the internal connection URL here:
DATABASE_URL=mysql+aiomysql://root:secure_db_password@db:3306/attendance_db

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Number of parallel Uvicorn worker processes (typically 2 to 4)
WEB_CONCURRENCY=2

# Strict Time-Lock Policy (MUST be False in production)
ALLOW_TIME_LOCK_BYPASS=False
