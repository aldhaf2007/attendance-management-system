# College Attendance Tracker Environment Configuration Example
PROJECT_NAME="College Attendance Tracker API"
VERSION="1.0.0"
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
KIOSK_PIN_TOKEN_EXPIRE_MINUTES=15

# PostgreSQL Database Connection String (using asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_db"

# Set to True only during local development/testing to bypass time-slot checks
ALLOW_TIME_LOCK_BYPASS=False
